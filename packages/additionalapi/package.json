{
    "name": "@lionweb/server-additionalapi",
    "version": "0.4.2-beta.3",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "build": "rm -rf dist && tsc",
        "alive": "echo I am alive",
        "lint": "eslint src",
        "release": "npm publish --access=public",
        "release-beta": "npm publish --tag beta --access=public",
        "publish-local": "npm publish --registry http://localhost:4873 --tag local",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local",
        "manualtest": "node dist/test/ManualTests.js"
    },
    "devDependencies": {
        "ts-proto": "2.11.8",
        "chai": "4.3.10"
    },
    "dependencies": {
        "@lionweb/json": "0.10.0-beta.8",
        "@lionweb/server-common": "0.4.2-beta.3",
        "@lionweb/server-database": "0.4.2-beta.3",
        "@lionweb/server-dbadmin": "0.4.2-beta.3",
        "@lionweb/server-shared": "0.4.2-beta.3",
        "@lionweb/server-logging": "0.4.2-beta.3",
        "@types/express": "4.17.21",
        "body-parser": "2.3.0",
        "chai": "4.3.10",
        "cors": "2.8.5",
        "dotenv": "16.3.1",
        "express": "4.22.2",
        "fs-extra": "11.1.1",
        "pg": "8.11.3",
        "pg-copy-streams": "7.0.0",
        "pg-promise": "11.7.8",
        "source-map-support": "0.5.21"
    },
    "engines": {
        "node": "^24.0.0"
    }
}
