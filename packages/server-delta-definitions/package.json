{
    "name": "@lionweb/server-delta-definitions",
    "version": "0.4.2-beta.3",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LionWeb-io/lionweb-repository.git"
    },
    "bugs": {
