{
    "name": "@lionweb/server-server",
    "version": "0.4.2-beta.3",
    "private": false,
    "main": "dist/index.js",
    "exports": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "dev-pglite-setup": "node dist/bin/lionweb-server.js --setup --config server-config-pglite.json",
        "dev-pglite-run": "node dist/bin/lionweb-server.js -- --run --config server-config-pglite.json",
        "dev-local-setup": "node dist/bin/lionweb-server.js --setup --config server-config.json",
        "dev-local-run": "node dist/bin/lionweb-server.js -- --run --config server-config.json",
        "dev-nas-setup": "node dist/bin/lionweb-server.js --setup --config server-config-titania.json",
        "dev-nas-run": "node dist/bin/lionweb-server.js -- --run --config server-config-titania.json",
        "dev-ci-setup": "node dist/bin/lionweb-server.js --setup --config server-config-ci.json",
        "dev-ci-run": "node dist/bin/lionweb-server.js --run --config server-config-ci.json",
        "pglite-in-memory": "npx @electric-sql/pglite-socket --port=45432 --host=0.0.0.0 --debug=0",
        "pglite-file": "npx @electric-sql/pglite-socket --port=45432 --host=0.0.0.0 --debug=0 --db lionwebdb",
        "build": "tsc",
        "alive": "echo I am alive",
        "lint": "eslint src",
        "release": "npm publish --access=public",
        "release-beta": "npm publish --tag beta --access=public",
        "publish-local": "npm publish --registry http://localhost:4873 --tag local",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local",
        "manualtest": "node dist/test/ManualTests.js"
    },
    "devDependencies": {
        "@types/cors": "2.8.19"
    },
    "dependencies": {
        "@lionweb/delta-server": "0.4.2-beta.3",
        "@lionweb/server-additionalapi": "0.4.2-beta.3",
        "@lionweb/server-bulkapi": "0.4.2-beta.3",
        "@lionweb/server-common": "0.4.2-beta.3",
        "@lionweb/server-database": "0.4.2-beta.3",
        "@lionweb/server-dbadmin": "0.4.2-beta.3",
        "@lionweb/server-delta-definitions": "0.4.2-beta.3",
        "@lionweb/server-delta-shared": "0.4.2-beta.3",
        "@lionweb/server-history": "0.4.2-beta.3",
        "@lionweb/server-inspection": "0.4.2-beta.3",
        "@lionweb/server-languages": "0.4.2-beta.3",
        "@lionweb/server-shared": "0.4.2-beta.3",
        "@lionweb/server-logging": "0.4.2-beta.3",
        "@lionweb/validation": "0.10.0-beta.8",
        "@types/express": "4.17.21",
        "@types/node": "24.13.0",
        "@types/pg-copy-streams": "1.2.5",
        "body-parser": "2.3.0",
        "cors": "2.8.5",
        "dotenv": "16.3.1",
        "express": "4.22.2",
        "fs-extra": "11.1.1",
        "pg": "8.11.3",
        "pg-copy-streams": "7.0.0",
        "pg-promise": "11.7.8",
        "source-map-support": "0.5.21",
        "ws": "8.20.0"
    },
    "bin": {
        "lionweb-server": "dist/bin/lionweb-server.js"
    },
    "engines": {
        "npm": ">=11.0.0",
        "node": ">=24.0.0"
    }
}
