{
    "private": false,
    "name": "@lionweb/server-http-client",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.4.2-beta.3",
    "description": "Library to access LionWeb server from a TypeScript/JavaScript client",
    "main": "dist/index.js",
    "exports": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "build": "tsc",
        "lint": "eslint src",
        "release": "npm publish --access=public",
        "release-beta": "npm publish --tag beta --access=public",
        "publish-local": "npm publish --registry http://localhost:4873 --tag beta",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local"
    },
    "dependencies": {
        "@lionweb/json": "0.10.0-beta.8",
        "@lionweb/server-shared": "0.4.2-beta.3"
    },
    "devDependencies": {
    },
    "engines": {
        "node": "^24.0.0"
    }
}
